# External skill packs — cloned by setup.sh
claude-seo/
seomachine/
superseo-skills/

# Store-specific runtime data stays local. Keep only the distributable default scaffold.
projects/*/
!projects/default/
!projects/default/**
projects/default/.DS_Store
projects/**/.runtime/
output/

# Google field/search evidence is local and can contain private business data.
projects/default/audits/crux/*
!projects/default/audits/crux/.gitkeep
projects/default/audits/gsc/*
!projects/default/audits/gsc/.gitkeep
