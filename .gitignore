.DS_Store
__pycache__/
**/__pycache__/
.venv/
.uv-cache/
.uv-python/
.runtime/
.ruff_cache/
.pytest_cache/
node_modules/
ui/dist/
extension/dist/
dist/
npm-debug.log*
.playwright-cli/
